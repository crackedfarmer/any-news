{
  "name": "any-news",
  "version": "1.4.1",
  "description": "Financial news plugin — economic calendar, earnings reports, and market events",
  "keywords": ["economics", "calendar", "trading", "market-events", "earnings"],
  "mcpServers": {
    "earnings": {
      "command": "node",
      "args": ["${CLAUDE_PLUGIN_ROOT}/.claude-plugin/mcp/earnings/index.js"],
      "env": {
        "FIRECRAWL_API_KEY": "${FIRECRAWL_API_KEY}"
      }
    },
    "macro-calendar": {
      "command": "node",
      "args": ["${CLAUDE_PLUGIN_ROOT}/.claude-plugin/mcp/macro-calendar/index.js"]
    }
  }
}
